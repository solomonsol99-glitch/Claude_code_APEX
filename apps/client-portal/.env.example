# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.
# None of these reach the browser.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Public address of the portal, used in auth email links. Leave unset on Vercel previews.
APP_URL=http://localhost:3000

# "sample" (estimates from the database overview) or "coreset" (live API, step 6)
DATA_PROVIDER=sample
