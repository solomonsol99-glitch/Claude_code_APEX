{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "platform": {
          "enum": [
            "twitter",
            "reddit"
          ],
          "title": "Platform",
          "type": "string"
        },
        "round": {
          "title": "Round",
          "type": "integer"
        },
        "success": {
          "default": true,
          "title": "Success",
          "type": "boolean"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "actor",
        "round",
        "platform"
      ],
      "title": "Action",
      "type": "object"
    },
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "persona_card_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona Card Id"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/PlatformProfile"
          },
          "propertyNames": {
            "enum": [
              "twitter",
              "reddit"
            ]
          },
          "title": "Profiles",
          "type": "object"
        },
        "segment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Id"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "Agent",
      "type": "object"
    },
    "Comment": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent Id"
        },
        "comment_id": {
          "title": "Comment Id",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "dislikes": {
          "default": 0,
          "title": "Dislikes",
          "type": "integer"
        },
        "likes": {
          "default": 0,
          "title": "Likes",
          "type": "integer"
        },
        "platform": {
          "enum": [
            "twitter",
            "reddit"
          ],
          "title": "Platform",
          "type": "string"
        },
        "post_id": {
          "title": "Post Id",
          "type": "string"
        },
        "round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round"
        }
      },
      "required": [
        "comment_id",
        "post_id",
        "agent_id",
        "platform",
        "content"
      ],
      "title": "Comment",
      "type": "object"
    },
    "EngineMeta": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "model_route": {
          "title": "Model Route",
          "type": "string"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "rounds": {
          "title": "Rounds",
          "type": "integer"
        },
        "timings_s": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timings S",
          "type": "object"
        },
        "token_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Usage"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "engine",
        "version",
        "model_route",
        "random_seed",
        "rounds"
      ],
      "title": "EngineMeta",
      "type": "object"
    },
    "InterviewAnswer": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "answer_text": {
          "title": "Answer Text",
          "type": "string"
        },
        "likert": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Likert"
        },
        "persona_card_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Persona Card Id"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "twitter",
                "reddit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "price_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Value"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "scope": {
          "default": "agent",
          "enum": [
            "agent",
            "segment",
            "overall"
          ],
          "title": "Scope",
          "type": "string"
        },
        "segment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Id"
        }
      },
      "required": [
        "question_id",
        "agent_id",
        "answer_text"
      ],
      "title": "InterviewAnswer",
      "type": "object"
    },
    "PlatformProfile": {
      "additionalProperties": false,
      "properties": {
        "bio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bio"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        }
      },
      "title": "PlatformProfile",
      "type": "object"
    },
    "Post": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent Id"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "dislikes": {
          "default": 0,
          "title": "Dislikes",
          "type": "integer"
        },
        "likes": {
          "default": 0,
          "title": "Likes",
          "type": "integer"
        },
        "original_post_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
