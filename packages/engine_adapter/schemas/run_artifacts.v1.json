          "type": "string"
        },
        "post_id": {
          "title": "Post Id",
          "type": "string"
        },
        "quote_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Content"
        },
        "round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round"
        },
        "shares": {
          "default": 0,
          "title": "Shares",
          "type": "integer"
        }
      },
      "required": [
        "post_id",
        "agent_id",
        "platform",
        "content"
      ],
      "title": "Post",
      "type": "object"
    },
    "RunStats": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "title": "Actions",
          "type": "integer"
        },
        "agents_actual": {
          "title": "Agents Actual",
          "type": "integer"
        },
        "agents_target": {
          "title": "Agents Target",
          "type": "integer"
        },
        "comments": {
          "title": "Comments",
          "type": "integer"
        },
        "posts": {
          "title": "Posts",
          "type": "integer"
        },
        "rounds_completed": {
          "title": "Rounds Completed",
          "type": "integer"
        },
        "rounds_planned": {
          "title": "Rounds Planned",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "agents_target",
        "agents_actual",
        "rounds_planned",
        "rounds_completed",
        "posts",
        "comments",
        "actions"
      ],
      "title": "RunStats",
      "type": "object"
    },
    "TimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "action_types": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Action Types",
          "type": "object"
        },
        "actions_total": {
          "title": "Actions Total",
          "type": "integer"
        },
        "active_agents": {
          "title": "Active Agents",
          "type": "integer"
        },
        "by_platform": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Platform",
          "type": "object"
        },
        "round": {
          "title": "Round",
          "type": "integer"
        }
      },
      "required": [
        "round",
        "actions_total",
        "active_agents"
      ],
      "title": "TimelineEntry",
      "type": "object"
    }
  },
  "$id": "https://schemas.coreset.example/mre/run_artifacts.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Actions",
      "type": "array"
    },
    "agents": {
      "items": {
        "$ref": "#/$defs/Agent"
      },
      "title": "Agents",
      "type": "array"
    },
    "arm_id": {
      "title": "Arm Id",
      "type": "string"
    },
    "comments": {
      "items": {
        "$ref": "#/$defs/Comment"
      },
      "title": "Comments",
      "type": "array"
    },
    "engine_meta": {
      "$ref": "#/$defs/EngineMeta"
    },
    "engine_report_markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Engine Report Markdown"
    },
    "interviews": {
      "items": {
        "$ref": "#/$defs/InterviewAnswer"
      },
      "title": "Interviews",
      "type": "array"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "posts": {
      "items": {
        "$ref": "#/$defs/Post"
      },
      "title": "Posts",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "run_artifacts.v1",
      "default": "run_artifacts.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stats": {
      "$ref": "#/$defs/RunStats"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEntry"
      },
      "title": "Timeline",
      "type": "array"
    }
  },
  "required": [
    "tenant_id",
    "job_id",
    "run_id",
    "arm_id",
    "agents",
    "stats",
    "engine_meta"
  ],
  "title": "RunArtifacts",
  "type": "object"
}
